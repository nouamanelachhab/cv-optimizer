{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "label", "category", "aliases"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "label": { "type": "string", "minLength": 1 },
      "category": {
        "type": "string",
        "enum": [
          "programming_language",
          "spoken_language",
          "tool",
          "framework",
          "database",
          "methodology",
          "soft_skill",
          "certification",
          "cloud",
          "other"
        ]
      },
      "aliases": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "ambiguous": { "type": "boolean" },
      "type": {
        "type": "string",
        "enum": ["hard_skill", "soft_skill", "language"]
      },
      "esco_uri": { "type": ["string", "null"] }
    }
  }
}
